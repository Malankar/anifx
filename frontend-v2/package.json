{
  "name": "frontend-v2",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.node.json && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview",
    "deploy": "vite build && firebase deploy --only hosting"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^20",
    "eslint": "^10",
    "globals": "^17",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8"
  }
}
