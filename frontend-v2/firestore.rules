rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    match /registrations/{regId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);

      // Create: must be signed in and stamping your own uid. Cap/waitlist
      // enforcement happens server-side in the onRegistrationCreated
      // Cloud Function, which runs right after and may flip status.
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;

      // Update: the owner may only attach a payment reference and move
      // pending_payment -> awaiting_verification. Everything else
      // (verified / waitlist, or any other field) is admin-only.
      allow update: if isAdmin()
        || (
          isSignedIn() &&
          resource.data.uid == request.auth.uid &&
          resource.data.status == 'pending_payment' &&
          request.resource.data.status == 'awaiting_verification' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['paymentRef', 'status'])
        );

      allow delete: if isAdmin();
    }

    // Written only by Cloud Functions (admin SDK bypasses rules) — the
    // Trigger Email extension reads/writes this collection to send mail.
    match /mail/{docId} {
      allow read, write: if false;
    }

    // entryId/waitlist counters per track, written only by Cloud Functions.
    match /counters/{trackId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
